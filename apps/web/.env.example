NEXT_PUBLIC_API_URL=http://localhost:8000
# Must match DriftGuard API SECRET_KEY (server routes call the API with this)
SECRET_KEY=change-me
# GitHub App install page (optional; defaults to https://github.com/apps/driftguard-reviews/installations/new)
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=
# Or set slug only: NEXT_PUBLIC_GITHUB_APP_SLUG=driftguard-reviews
# Legacy alias: NEXT_PUBLIC_GITHUB_APP_URL=
# Required in production for Auth.js (e.g. https://driftguard-blue.vercel.app)
AUTH_URL=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# From address for transactional email (technical briefing requests). Defaults
# to Resend's shared sandbox sender if unset — fine for local dev, replace
# with a verified sending domain in production.
RESEND_FROM_EMAIL=
# Inbox that receives "Request a technical briefing" form submissions. If
# unset, submissions are accepted and logged server-side only (no email sent).
BRIEFING_NOTIFY_EMAIL=

# --- Analytics & Ads (all optional; unset = no scripts load) ---
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads tag / conversion ID (e.g. AW-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Search Console verification token (the content= value of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
